# Runtime mode. Use production only for deployed environments.
NODE_ENV=development

# Server and API routing.
PORT=4000
BASE_URI=/api/v1

# Required secrets and database connection. Replace placeholders locally.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/gymstat
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin and CORS allowlist. Separate origins with commas.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Accept

# Production must explicitly select same-site or cross-site cookie deployment.
AUTH_COOKIE_SITE_MODE=same-site
# Set true in production, where the backend is served behind HTTPS.
# AUTH_COOKIE_SECURE=true

# Logging and request-rate limits.
LOG_LEVEL=DEBUG
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
COACH_API_RATE_LIMIT_MAX=300
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
REGISTRATION_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
REGISTRATION_VERIFICATION_RATE_LIMIT_MAX=10

# Brevo API credentials for registration verification and transactional email.
# Use a sender address verified in Brevo; never commit real credentials.
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=verified-sender@example.com
BREVO_FROM_NAME=GYMSTAT

# SMTP credentials for password-reset OTP and registration-email fallback. Never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Brevo Transactional SMS for registration OTP delivery via contact number.
# Reuses the same BREVO_API_KEY above — no separate key needed.
# BREVO_SMS_SENDER: alphanumeric sender name, max 11 characters (e.g. "GYMSTAT").
#   Must be pre-approved by Brevo for your account region.
#   Philippine (+63) numbers are supported as recipients.
# Prerequisites before live SMS works:
#   1. Your Brevo plan must include SMS credits (free plan may not include SMS).
#   2. Go to Brevo Dashboard → SMS → Settings and activate Transactional SMS.
#   3. Purchase SMS credits if required.
#   4. Alphanumeric sender names must be approved by Brevo for PH destination.
#      Alternative: use a numeric sender (your verified phone number, 12-15 digits).
BREVO_SMS_SENDER=GYMSTAT

# Optional DNS override for MongoDB SRV resolution.
# MONGO_DNS_SERVERS=1.1.1.1,8.8.8.8
